# ShellMate configuration

# Server
SHELLMATE_HOST=127.0.0.1
SHELLMATE_PORT=8765
# Optional: keep the data folder somewhere other than beside the exe.
# Wins over data-dir.txt. The Move tool in Settings writes that file instead.
# SHELLMATE_DATA_DIR=

# AI providers (all optional — leave blank to disable).
#
# Leave these blank and set the keys in Settings instead: those go into the
# encrypted vault, and the vault wins over anything here. A key in this file
# is in plain text on disk and in any support bundle that picks the file up.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=

# ANTHROPIC_API_KEY is also accepted under its older name. Set one or the
# other; ANTHROPIC_API_KEY wins if both are present.
CLAUDE_API_KEY=

# Which model each provider falls back to when the picker has not chosen
# one. Defaults shown; a blank line here keeps the default.
OPENAI_MODEL=gpt-4o
XAI_MODEL=grok-3
DEEPSEEK_MODEL=deepseek-chat

# Ollama (optional — defaults shown)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b

# Default AI backend: "claude" or "ollama"
DEFAULT_AI_BACKEND=ollama

# Ansible runner (optional). ShellMate drives a container running Ansible;
# the address and the certificate paths belong in Settings → Ansible.
#
# This variable is a fallback for a headless or scripted install. Prefer
# Settings, which puts the token in the encrypted vault. Whatever you do,
# do not paste a real token into this file and commit it: an example config
# is read for its shape and never for its contents, which is exactly why a
# real value in one survives review.
ANSIBLE_RUNNER_TOKEN=

# Jira, for Conclude Session (optional — leave blank to disable)
JIRA_URL=
JIRA_USER_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# Serial port defaults (Windows)
DEFAULT_SERIAL_PORT=COM3
DEFAULT_BAUD_RATE=9600

# Chroma vector DB (optional — leave CHROMA_URL blank to disable)
# When set, ShellMate queries this collection for design-guideline snippets
# and injects matches into the AI prompt on every chat.
CHROMA_URL=
CHROMA_COLLECTION=design_guidelines

# Access token. Leave blank for the normal case: ShellMate binds 127.0.0.1
# and has no authentication because nothing else can reach the port.
#
# REQUIRED if you change SHELLMATE_HOST to anything else — including the
# Docker deployment, which binds 0.0.0.0. ShellMate refuses to start when
# bound wider than loopback with this unset, because a warning in a log
# nobody reads is how an installation ends up exposed.
#
# Use a long random string:  python -c "import secrets;print(secrets.token_urlsafe(32))"
SHELLMATE_AUTH_TOKEN=
